# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Data files (too large for git — keep locally)
# NOTE: deliberately NOT a blanket *.json ignore — that silently drops config
# and fixture files (the data/ ignore below covers bulk data)
*.csv
*.npz
*.har

# Media
media/*
!media/.gitkeep

# Data
data/*
!data/.gitkeep

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Private working notes — must never be published
drafts/
